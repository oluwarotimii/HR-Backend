# Dependencies
# node_modules/ is intentionally NOT ignored — this server deploys via
# `git pull` only (no `npm install`/`npm run build` on the host, due to
# memory limits), so a clean, production-only node_modules (see the
# "vendor-prod-deps" npm script) is committed alongside dist/.
node_modules.*-backup/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml

# Build output (not needed when running from source)
# build/
*.local

# Environment files (SENSITIVE - never commit)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.render
.env.prod

# Allow .env.example (template with no secrets)
!.env.example

# Render
render.yaml
.renderignore

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/

# Server
server.pid

# Uploads (keep this folder but don't commit files)
uploads/*
!uploads/.gitkeep

# Documentation (optional)
docs/
*.md
!README.md
